<?xml version="1.0" encoding="utf-8"?>
<!-- Graviton brand mark: rounded-triangle play symbol, blue-to-violet gradient, gravitational
     rings, deep navy background. Used for in-app branding (About screen, splash). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep navy rounded card. -->
    <path android:pathData="M26,0 L82,0 A26,26 0 0 1 108,26 L108,82 A26,26 0 0 1 82,108 L26,108 A26,26 0 0 1 0,82 L0,26 A26,26 0 0 1 26,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="46"
                android:gradientRadius="86"
                android:startColor="#FF1B2650"
                android:endColor="#FF0A0F24" />
        </aapt:attr>
    </path>

    <!-- Soft gravitational glow behind the mark. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="30"
                android:startColor="#294F8DFF"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-16">

        <!-- Outer gravitational ring segment. -->
        <path
            android:pathData="M25.81,58.45 A30,13 0 0,0 82.19,58.45"
            android:strokeWidth="2.4"
            android:strokeAlpha="0.85"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="25.8"
                    android:startY="58.4"
                    android:endX="82.2"
                    android:endY="58.4"
                    android:startColor="#FF6FA3FF"
                    android:endColor="#FFB18CFF" />
            </aapt:attr>
        </path>

        <!-- Inner ring, back half (passes behind the play mark). -->
        <path
            android:pathData="M28,54 A26,10.5 0 1,1 80,54"
            android:strokeWidth="2.4"
            android:strokeAlpha="0.45"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="28"
                    android:startY="54"
                    android:endX="80"
                    android:endY="54"
                    android:startColor="#FF6FA3FF"
                    android:endColor="#FFB18CFF" />
            </aapt:attr>
        </path>
    </group>

    <!-- Rounded play mark with the Graviton blue-to-violet gradient. -->
    <path android:pathData="M37.55,50.5 L37.55,57.5 Q37.55,63.5 43.35,61.95 L67.2,55.55 Q73,54 67.2,52.45 L43.35,46.05 Q37.55,44.5 37.55,50.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="37.5"
                android:startY="54"
                android:endX="73"
                android:endY="54"
                android:startColor="#FF4D8DFF"
                android:endColor="#FF9B6BFF" />
        </aapt:attr>
    </path>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-16">
        <!-- Inner ring, front half (passes in front of the play mark). -->
        <path
            android:pathData="M80,54 A26,10.5 0 1,1 28,54"
            android:strokeWidth="2.4"
            android:strokeAlpha="0.95"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="28"
                    android:startY="54"
                    android:endX="80"
                    android:endY="54"
                    android:startColor="#FF6FA3FF"
                    android:endColor="#FFB18CFF" />
            </aapt:attr>
        </path>
    </group>
</vector>
